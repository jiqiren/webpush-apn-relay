            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(relay_unsubscribes_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ]
    },
