    {
      "id": 13,
      "type": "timeseries",
      "title": "Queue depth vs capacity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Messages waiting for a worker. Capacity is -max-queue-size; note that each slot holds a pointer to a payload, so raising it costs real RAM.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
